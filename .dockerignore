# ═══════════════════════════════════════
# Molo Studio — Docker Ignore
# ═══════════════════════════════════════

# Node
node_modules/
studio/node_modules/
studio/.next/

# Python
.venv/
__pycache__/
*.pyc

# IDE & tools
.DS_Store
.agents/
.gemini/
.git/

# Root-level media junk (NOT project media)
# NOTE: We do NOT ignore *.mp4, *.png etc globally
# because projects/ contains valid media files
/klinik_/
/_voices/
/_images-generated/
/_videos-raw/

# Temp files
*.log
*.tmp
